{
  "name": "career-watch-telegram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitor official company career feeds, estimate compensation with Gemini, and notify Telegram.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "scan": "node src/index.js",
    "scan:existing": "node src/index.js --notify-existing",
    "scan:dry": "node src/index.js --notify-existing --dry-run",
    "telegram:chat-id": "node src/get-chat-id.js",
    "telegram:test": "node src/send-telegram.js",
    "test": "node --test"
  }
}
