# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# For fresher salary research, use gemini-3.6-flash and set this to true.
GEMINI_USE_GOOGLE_SEARCH=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Replace these with your real current guaranteed annual gross base salaries.
# When left at 0, relevant jobs are shown without a pay-threshold decision.
ENGINEERING_BASELINE_EUR=0
DESIGN_BASELINE_EUR=0

# Require the conservative estimated base salary to beat the baseline by this percentage.
DESIRED_IMPROVEMENT_PERCENT=10
MIN_MATCH_SCORE=70
INCLUDE_POSSIBLE_MATCHES=true
MAX_AI_JOBS_PER_RUN=30

# Optional behaviour
SEND_SCAN_SUMMARY=false
SEND_SOURCE_ERRORS=true
NOTIFY_UPDATES=false
